{
  "apps" : [{
     "name" : "cattr-docs-user-manual",
     "script" : "npx",
     "args": ["docsify", "serve", "./docs", "-p", "3002"]
  }],
  "deploy" : {
    "production" : {
      "user" : "cattr-deploy",
      "host" : ["docs.cattr.app"],
      "ref"  : "origin/release",
      "repo" : "git@git.amazingcat.net:AmazingTime/docs/user-manual",
      "path" : "/srv/docs/user-manual",
      "post-deploy" : "git lfs pull; npm install; npm run sitemap; pm2 startOrRestart ecosystem.json; git reset --hard"
     }
  }
}
